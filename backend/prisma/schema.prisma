// Prisma schema — PostgreSQL runs in parallel with MongoDB (Step 1).
// First model: Feedback (matches legacy feedback.json shape for future migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feedback {
  id        String   @id @default(cuid())
  legacyId  String?  @unique @map("legacy_id")
  userId    String   @map("user_id")
  userName  String   @default("Anonymous") @map("user_name")
  orderId   String?  @map("order_id")
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([orderId])
  @@map("feedback")
}

// Manager restaurant CRUD (PostgreSQL only — MongoDB /api/restaurants unchanged)
model Restaurant {
  id           String   @id @default(cuid())
  restaurantId String   @unique @map("restaurant_id")
  name         String
  cluster      String   @default("North Campus")
  address      String?
  phone        String?
  email        String?
  manager      String?
  capacity     Int      @default(0)
  isOpen       Boolean  @default(true) @map("is_open")
  statusNote   String   @default("") @map("status_note")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("restaurants")
}
