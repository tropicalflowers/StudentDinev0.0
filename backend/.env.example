# Copy to .env and fill in values. MongoDB is required; PostgreSQL is optional for Step 1.

PORT=3000
NODE_ENV=development

# MongoDB (required — existing app)
MONGODB_URI=mongodb://localhost:27017/studentdine

# PostgreSQL (Neon / Prisma) — optional at runtime; server starts if unset or unreachable
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_SECRET=change_me_in_production
JWT_EXPIRE=7d
